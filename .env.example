# Aplicacao
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# PostgreSQL
POSTGRES_DB=capsula
POSTGRES_USER=capsula
POSTGRES_PASSWORD=capsula_dev_password
POSTGRES_PORT=5432

# Prisma (deve refletir as credenciais e a porta do PostgreSQL acima)
DATABASE_URL=postgresql://capsula:capsula_dev_password@localhost:5432/capsula

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Usados pela API para falar com o MinIO (as credenciais sao as MINIO_ROOT_* acima)
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_BUCKET=capsula

# Resend
RESEND_API_KEY=
# Remetente. O padrao do Resend (onboarding@resend.dev) so entrega para o e-mail da sua conta Resend.
RESEND_FROM_EMAIL=Capsula do Tempo <onboarding@resend.dev>

# Web
# URL base do front-end; o e-mail de entrega leva o link de abertura ${WEB_URL}/c/<token>.
WEB_URL=http://localhost:5173

# Auth
JWT_SECRET=troque-por-uma-chave-secreta-bem-longa-e-aleatoria
JWT_EXPIRES_IN=1h

# Download publico (validade em segundos, entre 1 e 604800)
MINIO_REGION=us-east-1
MINIO_PRESIGNED_URL_TTL_SECONDS=900
