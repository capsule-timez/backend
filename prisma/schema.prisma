// A URL de conexao nao fica aqui: no Prisma 7 ela e lida de DATABASE_URL em
// prisma.config.ts (CLI) e passada ao driver adapter em src/lib/prisma.ts (runtime).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Adicione isto no FINAL do seu prisma/schema.prisma existente — o
// "generator client" e o "datasource db" que você já tem continuam lá em
// cima, sem alteração. Só o model é novo.

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  passhash  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

// ASSUNÇÃO: id como Int autoincrement. Se Capsule/CapsuleFile usam UUID,
// troque para: id String @id @default(uuid())