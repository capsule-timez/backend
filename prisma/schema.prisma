// A URL de conexao nao fica aqui: no Prisma 7 ela e lida de DATABASE_URL em
// prisma.config.ts (CLI) e passada ao driver adapter em src/lib/prisma.ts (runtime).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CapsuleStatus {
  SCHEDULED
  SENT
  FAILED

  @@map("capsule_status")
}

enum CapsuleType {
  INDIVIDUAL
  GROUP

  @@map("capsule_type")
}

enum CapsuleMemberRole {
  OWNER
  MEMBER

  @@map("capsule_member_role")
}

enum CapsuleInviteStatus {
  PENDING
  ACCEPTED

  @@map("capsule_invite_status")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  passhash  String
  createdAt DateTime @default(now()) @map("created_at")

  capsules        Capsule[]
  memberships     CapsuleMember[]
  contributions   CapsuleContribution[]
  invitesSent     CapsuleInvite[]       @relation("InviteSender")
  invitesAccepted CapsuleInvite[]       @relation("InviteAcceptor")

  @@map("users")
}

model Capsule {
  id                   String        @id @default(uuid()) @db.Uuid
  creatorId            String        @map("id_creator") @db.Uuid
  titleContent         String        @map("title_content")
  textContent          String        @map("text_content")
  recipientEmail       String        @map("recipient_email")
  scheduleDate         DateTime      @map("schedule_date")
  type                 CapsuleType   @default(INDIVIDUAL)
  contributionDeadline DateTime?     @map("contribution_deadline")
  inviteCode           String?       @unique @map("invite_code")
  status               CapsuleStatus @default(SCHEDULED)
  // Hash SHA-256 (hex) do token de acesso enviado no link ao destinatario.
  // O texto puro nunca e persistido; ver src/lib/accessToken.ts.
  token                String        @unique
  sentAt               DateTime?     @map("sent_at")
  createdAt            DateTime      @default(now()) @map("created_at")

  creator       User                  @relation(fields: [creatorId], references: [id])
  files         CapsuleFile[]
  members       CapsuleMember[]
  contributions CapsuleContribution[]
  invites       CapsuleInvite[]

  // Atende a busca do job de entrega: capsulas SCHEDULED com schedule_date vencida.
  @@index([status, scheduleDate])
  @@index([creatorId])
  @@map("capsules")
}

model CapsuleMember {
  capsuleId String            @map("id_capsule") @db.Uuid
  userId    String            @map("id_user") @db.Uuid
  role      CapsuleMemberRole
  joinedAt  DateTime          @default(now()) @map("joined_at")

  capsule Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([capsuleId, userId])
  @@index([userId])
  @@map("capsule_members")
}

// Contribuicao de um participante numa capsula em grupo. Nao pode ser editada
// nem removida depois de enviada; sai junto com a capsula (onDelete: Cascade).
model CapsuleContribution {
  id        String   @id @default(uuid()) @db.Uuid
  capsuleId String   @map("id_capsule") @db.Uuid
  authorId  String   @map("id_author") @db.Uuid
  // Opcional quando a contribuicao tem ao menos uma imagem.
  text      String?
  createdAt DateTime @default(now()) @map("created_at")

  capsule Capsule       @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  files   CapsuleFile[]

  @@index([capsuleId, createdAt])
  @@index([authorId])
  @@map("capsule_contributions")
}

model CapsuleFile {
  id             String   @id @default(uuid()) @db.Uuid
  capsuleId      String   @map("id_capsule") @db.Uuid
  // Preenchido quando a imagem pertence a uma contribuicao; nulo nos anexos
  // da propria capsula.
  contributionId String?  @map("id_contribution") @db.Uuid
  mimeType       String   @map("mime_type")
  fileName       String   @map("file_name")
  // Tamanho em bytes.
  fileSize       Int      @map("file_size")
  // Chave do objeto no bucket do MinIO.
  objectKey      String   @unique @map("object_key")
  createdAt      DateTime @default(now()) @map("created_at")

  capsule      Capsule              @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  contribution CapsuleContribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@index([capsuleId])
  @@index([contributionId])
  @@map("capsule_files")
}

// Convite por e-mail para uma capsula em grupo. Um registro por e-mail e
// capsula: convidar de novo gera outro token e renova a validade.
model CapsuleInvite {
  id           String              @id @default(uuid()) @db.Uuid
  capsuleId    String              @map("id_capsule") @db.Uuid
  // Normalizado em minusculas.
  email        String
  // Hash SHA-256 (hex) do token enviado no link. O texto puro nunca e
  // persistido; ver src/lib/accessToken.ts.
  tokenHash    String              @unique @map("token_hash")
  status       CapsuleInviteStatus @default(PENDING)
  // Igual ao contributionDeadline da capsula no momento do envio.
  expiresAt    DateTime            @map("expires_at")
  invitedById  String              @map("id_invited_by") @db.Uuid
  acceptedById String?             @map("id_accepted_by") @db.Uuid
  acceptedAt   DateTime?           @map("accepted_at")
  // Data do ultimo envio do e-mail.
  sentAt       DateTime            @default(now()) @map("sent_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  capsule    Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("InviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([capsuleId, email])
  @@index([invitedById])
  @@index([acceptedById])
  @@map("capsule_invites")
}
